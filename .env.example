# =============================================================================
# nena-man · Root .env.example
# Template of ALL environment variables the system reads.
# COPY this file to .env and fill in real values.
# NEVER commit a .env file — it is gitignored by default.
# Share real values via the team's shared password manager or Firebase Console.
# =============================================================================

# --- Firebase Project (shared across frontend and backend) ---
# Source: Firebase Console → Project Settings → General
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# See frontend/.env.example for Expo / React Native specific variables.
# See backend/.env.example  for Flask API specific variables.
