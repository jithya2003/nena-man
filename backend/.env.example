# =============================================================================
# nena-man · backend/.env.example
# Flask API environment variables template.
# Copy to .env and fill in real values. NEVER commit .env.
# =============================================================================

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-with-a-long-random-secret-key
PORT=5000

# Firebase Admin SDK
# Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-adminsdk.json
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# ML Model paths (relative to backend/)
# Checkpoints are NOT in git — see ml/README.md for download instructions
M1_MODEL_PATH=./app/modules/speech_classifier/models/
M2_MODEL_PATH=./app/modules/text_difficulty/models/
M3_MODEL_PATH=./app/modules/recommendation_engine/models/
M4_MODEL_PATH=./app/modules/behavioral_detection/models/

# HuggingFace (for Whisper / Wav2Vec2 downloads)
# HUGGINGFACE_TOKEN=hf_your_token_here
