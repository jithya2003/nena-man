# =============================================================================
# nena-man · Sinhala Dyslexia Reading Assistant  ·  IT4010 · J26-IT-361
# .gitignore — each section explains WHY things are excluded, not just what.
# =============================================================================


# -----------------------------------------------------------------------------
# NODE / EXPO  (frontend/)
# node_modules is machine-generated; every dev runs `npm install` to recreate.
# Committing it wastes hundreds of MB and causes endless merge conflicts.
# .expo and .expo-shared hold Expo CLI's local dev state — machine-specific.
# ios/ and android/ native build folders are generated by `expo prebuild` or
# EAS Build. They are enormous and must be rebuilt per environment.
# -----------------------------------------------------------------------------
node_modules/
.expo/
.expo-shared/
dist/
.cache/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Expo EAS / managed-workflow native outputs
android/
ios/

# Expo web build output — generated by `expo export:web`
web-build/


# -----------------------------------------------------------------------------
# PYTHON / FLASK  (backend/)
# __pycache__ and *.pyc are Python bytecode — machine and Python-version
# specific. They regenerate automatically on first import.
# venv/.venv are local virtual environments. Every dev creates their own
# with the pinned requirements.txt.
# instance/ holds Flask's per-deployment runtime config and any local SQLite DBs.
# .pytest_cache holds pytest's run metadata — regenerated on each test run.
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyc
venv/
.venv/
env/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
instance/
*.sqlite
*.db


# -----------------------------------------------------------------------------
# ML MODEL CHECKPOINTS & BINARY ARTEFACTS  (ml/)
# Trained model files range from tens of MB to several GB — version control
# is the wrong tool for binary blobs of this size.
# Store checkpoints on:  Google Drive  |  HuggingFace Hub  |  AWS S3
# See ml/README.md for the download / restore instructions.
# -----------------------------------------------------------------------------
*.pt
*.pth
*.h5
*.hdf5
*.pkl
*.pickle
*.onnx
*.bin
*.safetensors
*.joblib
*.npy
*.npz

# Checkpoint directories — use gitkeep files only to preserve folder structure
ml/checkpoints/*
!ml/checkpoints/.gitkeep

# Raw datasets — store on Google Drive / university NAS, NOT in git
ml/data/*
!ml/data/.gitkeep


# -----------------------------------------------------------------------------
# RAW AUDIO / DATASET FILES
# Audio recordings and text corpora are large binary files. Git does NOT
# diff or compress binary files efficiently — committing audio data will
# make the repo unusable. Document fetch steps in ml/README.md instead.
# Note: *.wav inside frontend/assets/ are intentionally NOT excluded here,
# since small UI sound effects are fine to commit. Only the bulk ML data
# directories above are excluded.
# -----------------------------------------------------------------------------
datasets/
data/raw/
data/processed/

# Jupyter auto-saves a checkpoint on every manual save. These are not source.
.ipynb_checkpoints/


# -----------------------------------------------------------------------------
# SECRETS & CREDENTIALS
# NEVER commit API keys, Firebase service accounts, or any .env file with
# real values. .env.example is the safe template — commit that, never .env.
# Firebase Admin SDK service-account JSON files grant full project access.
# GoogleService-Info.plist / google-services.json contain API keys.
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
firebase-adminsdk-*.json
*-service-account.json
serviceAccountKey.json
google-services.json
GoogleService-Info.plist


# -----------------------------------------------------------------------------
# EDITOR & OS NOISE
# .DS_Store is a macOS Finder artefact. Thumbs.db is Windows Explorer's.
# .idea is JetBrains IDE state. .vscode/settings.json holds machine-specific
# paths (Python interpreter, etc.). We DO commit .vscode/extensions.json to
# share recommended extensions across the team.
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
Thumbs.db
desktop.ini
ehthumbs.db
.idea/
*.swp
*.swo
*~

# VS Code — share extensions.json but not machine-specific settings
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json


# -----------------------------------------------------------------------------
# TEST & COVERAGE REPORTS
# Generated by pytest-cov and Jest — regenerated on each test run.
# Never commit coverage reports; they create enormous diffs on every run.
# -----------------------------------------------------------------------------
coverage/
htmlcov/
.coverage
.coverage.*
lcov.info
*.lcov


# -----------------------------------------------------------------------------
# MISCELLANEOUS
# -----------------------------------------------------------------------------
# Generic build artefacts
build/
*.tgz

# Temporary files
*.tmp
*.bak
*.orig
